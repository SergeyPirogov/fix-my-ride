# --- Vercel project (backend, api/strava-token.js) ---
# Set in the Vercel dashboard → Settings → Environment Variables.
# Never put the real client secret in a committed file.

STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
ALLOWED_ORIGIN=https://automation-remarks.com

# --- GitHub Actions (frontend build, .github/workflows/deploy.yml) ---
# Set as repository VARIABLES (not secrets — client_id and the function
# URL aren't sensitive) at Settings → Secrets and variables → Actions → Variables.

# STRAVA_CLIENT_ID=your_strava_client_id            (same value as above)
# STRAVA_TOKEN_URL=https://your-project.vercel.app/api/strava-token
